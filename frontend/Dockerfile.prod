# Stage 1: Build stage
FROM node:20-alpine as builder

# Argumentos de construcción - Railway pasa variables de entorno automáticamente
ARG VITE_API_URL

# Establecer variables de entorno para el build
ENV VITE_API_URL=${VITE_API_URL}
ENV NODE_ENV=production

# Debug: mostrar la URL configurada
RUN echo "Building with VITE_API_URL=${VITE_API_URL}"

# Instalar dependencias del sistema si son necesarias
RUN apk add --no-cache python3 make g++

# Establecer directorio de trabajo
WORKDIR /app

# Copiar archivos de dependencias
COPY package.json package-lock.json ./

# Instalar todas las dependencias (incluyendo devDependencies para el build)
RUN npm ci

# Copiar código fuente
COPY . .

# Ejecutar build de producción
RUN npm run build

# Stage 2: Runtime stage con Nginx
FROM nginx:1.25-alpine

# Variable de entorno para puerto (Railway usa $PORT)
ENV PORT=80

# Copiar configuración personalizada de nginx (template)
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Copiar archivos build desde stage anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Exponer puerto
EXPOSE ${PORT}

# Nginx se ejecuta en foreground - envsubst reemplaza $PORT en la config
CMD /bin/sh -c "envsubst '\$PORT' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
